# ============================================================
# 🛡️ AEGIS-CLIMATE — Environment Variables & API Key Configuration
# BHARAT AGENTIC 2026 (12-Hour Hackathon)
# ============================================================
# Instructions:
# 1. Fill in your API keys below (or enter them directly in the UI settings).
# 2. Never commit your secret keys to public git (this file is ignored).
# ============================================================

# ------------------------------------------------------------
# 🌍 1. CORE APPLICATION CONFIG
# ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
APP_NAME=AEGIS-CLIMATE
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*

# ------------------------------------------------------------
# 🤖 2. AGENTIC AI & LLM REASONING KEYS (MANDATORY FOR LIVE LLM)
# ------------------------------------------------------------
# Primary GenAI Engine: Google Gemini 1.5 Pro / Flash
# Powers Agent 3 dynamic policy reasoning, SEBI BRSR gap analysis, and Devanagari civic alerts
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ultra-Fast LLM Inference: Groq Cloud (Llama-3-70B / Mixtral-8x7b)
# Powers sub-500ms Agent Thought Trace monologue and instant alert generation
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Fallback LLM 1: OpenAI (GPT-4o / GPT-4o-mini)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Fallback LLM 2: Anthropic Claude (Claude 3.5 Sonnet)
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# 🛰️ 3. METEOROLOGICAL & EARTH OBSERVATION APIS
# ------------------------------------------------------------
# Open-Meteo API Base URL (Free tier requires no key; commercial key optional)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_API_KEY=

# ISRO Bhuvan / Copernicus Sentinel-2 / NASA Earthdata (Optional for custom rasters)
EARTHDATA_TOKEN=

# ------------------------------------------------------------
# 🗺️ 4. GEOSPATIAL & GIS VECTOR TILES
# ------------------------------------------------------------
# Mapbox Access Token (Optional for 3D terrain elevation and satellite basemap)
# Get key at: https://account.mapbox.com/access-tokens/
MAPBOX_API_TOKEN=

# ------------------------------------------------------------
# 🎙️ 5. BHASHA-AI VERNACULAR VOICE SYNTHESIS
# ------------------------------------------------------------
# ElevenLabs API Key (Hyper-realistic Hindi & Indian English voice dispatch)
# Get key at: https://elevenlabs.io/app/speech-synthesis
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sarvam AI / Bhashini API Key (Specialized Indian language translation & TTS)
# Get key at: https://www.sarvam.ai/
SARVAM_API_KEY=

# ------------------------------------------------------------
# 🗄️ 6. VECTOR DATABASE & CACHE STACK
# ------------------------------------------------------------
CHROMADB_HOST=localhost
CHROMADB_PORT=8002
CHROMA_PERSIST_DIRECTORY=./chroma_db
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://aegis:aegis_password@localhost:5432/aegis_db

# ------------------------------------------------------------
# ⚡ 7. AUTONOMOUS AGENT RISK THRESHOLDS
# ------------------------------------------------------------
ACUTE_RISK_TRIGGER_THRESHOLD=0.65   # Prob > 0.65 triggers Agent 2 (DEM Geo Exposure)
CHRONIC_DAMAGE_THRESHOLD=0.70       # Severity > 0.70 triggers Agent 3 (Financial VaR)

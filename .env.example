# ============================================================
# AEGIS-CLIMATE — Environment Variables Template
# ============================================================
APP_NAME=AEGIS-CLIMATE
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Services
MCP_HUB_URL=http://localhost:8001/mcp/invoke
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://aegis:aegis_secure_password@localhost:5432/aegis_db
DB_PASSWORD=aegis_secure_password
CHROMADB_HOST=localhost
CHROMADB_PORT=8002

# AI / LLM APIs
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

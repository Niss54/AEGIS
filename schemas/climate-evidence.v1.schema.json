{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-climate.io/schemas/climate-evidence.v1.schema.json",
  "title": "AEGIS Climate Evidence Bundle v1",
  "description": "Normative schema for tamper-evident climate risk evidence bundles under IEEE ClimateChain specifications.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "analysis",
    "model_manifest",
    "code_revision",
    "limitations",
    "hash_algorithm",
    "canonicalization_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis": {
      "type": "object",
      "required": [
        "analysis_id",
        "location",
        "created_at_utc",
        "data_mode",
        "inputs",
        "transformations",
        "risk_output",
        "exposure_output",
        "policy_output"
      ],
      "properties": {
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "required": ["region_label", "latitude", "longitude"],
          "properties": {
            "region_label": {"type": "string"},
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180},
            "coordinate_commitment": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "created_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "data_mode": {
          "type": "string",
          "enum": ["live", "fixture", "synthetic"]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "variable", "value", "unit", "is_synthetic"],
            "properties": {
              "source": {"type": "string"},
              "variable": {"type": "string"},
              "value": {"type": "number"},
              "unit": {"type": "string"},
              "is_synthetic": {"type": "boolean"},
              "timestamp_utc": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "method", "description"],
            "properties": {
              "step": {"type": "string"},
              "method": {"type": "string"},
              "description": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "risk_output": {
          "type": "object",
          "required": ["risk_score", "risk_tier", "dominant_factor"],
          "properties": {
            "risk_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "risk_tier": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
            "dominant_factor": {"type": "string"},
            "probabilities": {
              "type": "object",
              "properties": {
                "LOW": {"type": "number"},
                "MEDIUM": {"type": "number"},
                "HIGH": {"type": "number"},
                "CRITICAL": {"type": "number"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "exposure_output": {
          "type": "object",
          "required": ["exposure_tier", "waterlogging_depth_cm", "buildings_at_risk", "drainage_overflow_pct"],
          "properties": {
            "exposure_tier": {"type": "string"},
            "waterlogging_depth_cm": {"type": "integer", "minimum": 0},
            "buildings_at_risk": {"type": "integer", "minimum": 0},
            "drainage_overflow_pct": {"type": "number", "minimum": 0, "maximum": 100},
            "damage_estimate_inr": {"type": "number", "minimum": 0},
            "methodology": {"type": "string"}
          },
          "additionalProperties": false
        },
        "policy_output": {
          "type": "object",
          "required": ["var_estimate_inr", "stranded_asset_risk", "compliance_gap_pct"],
          "properties": {
            "var_estimate_inr": {"type": "number", "minimum": 0},
            "stranded_asset_risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
            "compliance_gap_pct": {"type": "integer", "minimum": 0, "maximum": 100},
            "applicable_regulations": {
              "type": "array",
              "items": {"type": "string"}
            },
            "legal_disclaimer": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "model_manifest": {
      "type": "object",
      "required": ["model_id", "artifact_sha256", "feature_schema_version"],
      "properties": {
        "model_id": {"type": "string"},
        "artifact_sha256": {"type": "string"},
        "feature_schema_version": {"type": "string"},
        "algorithm": {"type": "string"},
        "features": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "code_revision": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hash_algorithm": {
      "type": "string",
      "const": "keccak256"
    },
    "canonicalization_version": {
      "type": "string",
      "const": "aegis-canonical-json-v1"
    }
  },
  "additionalProperties": false
}
